# Anthropic API key used for the "reasoning" step (structuring raw PDF text into line items).
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Model id used for the structuring step. Pin an exact version for reproducibility.
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Port the local server listens on.
PORT=3000
