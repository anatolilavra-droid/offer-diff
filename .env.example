# The "reasoning" step (structuring raw PDF text into line items) uses whichever
# of these is configured, checked in this order: GEMINI_API_KEY, then
# ANTHROPIC_API_KEY. If neither is set, a deterministic regex mock is used
# instead (see src/ai/mockProvider.ts) so the rest of the app stays runnable.

# Google AI Studio key (has a genuinely free tier, no card required).
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Anthropic API key (paid, pay-as-you-go). Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Port the local server listens on.
PORT=3000
